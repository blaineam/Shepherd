# The NAS's fixed LAN IPv4 address (reserve it in your router). Used for health checks.
HOST_IP=192.168.1.10

# Tailscale auth key (admin console -> Settings -> Keys). Only needed for a brand-new
# node; leave blank when migrating existing state (docs/MIGRATING-TAILSCALE.md).
TS_AUTHKEY=
# Name this node shows up as in your tailnet. When migrating, keep your existing name.
TS_HOSTNAME=shepherd
# Comma-separated subnets to advertise over Tailscale (your LAN). IPv4 shown;
# add your IPv6 prefix only after reading docs/IPV6.md (forwarding trap).
LAN_ROUTES=192.168.1.0/24
