#!/usr/bin/env bash
# coverage: run the tests with the race detector and enforce the coverage floor.
#   coverage            fail when total coverage is below .coverage-floor
#   coverage --ratchet  also raise the floor when coverage has risen well above it
set -eu
cd "$(git rev-parse --show-toplevel)"
floor=$(tr -d '[:space:]' < .coverage-floor)
go test -race -count=1 -coverprofile=coverage.out ./...
# cmd/intercept-trial is excluded from the floor: it is a hand-run, Linux-only
# CLI that needs CAP_NET_RAW/CAP_NET_ADMIN and live hardware to exercise most
# of its own logic (see docs/INTERCEPT.md), the same way internal/intercept's
# own raw-socket code is untestable without it — its statement count would
# otherwise drag the whole-repo total down by a couple of points on every CI
# run (Linux-only code this package's own tests can't reach on a non-Linux
# dev machine, so a local run never sees the gap the way CI's ubuntu-latest
# runner does). Its own tests still run above, in the full suite; only the
# floor calculation ignores it.
grep -v '^shepherd/cmd/intercept-trial/' coverage.out > coverage.floor.out
total=$(go tool cover -func=coverage.floor.out | awk '/^total:/ { sub("%", "", $3); print $3 }')
echo "coverage: ${total}% (floor ${floor}%)"
awk -v t="$total" -v f="$floor" 'BEGIN { exit !(t + 0 >= f + 0) }' || { echo "coverage fell below the floor" >&2; exit 1; }
if [ "${1:-}" = --ratchet ]; then
  new=$(awk -v t="$total" 'BEGIN { print int(t) - 1 }')
  if awk -v n="$new" -v f="$floor" 'BEGIN { exit !(n + 0 > f + 0) }'; then
    echo "$new" > .coverage-floor
    echo "floor raised to ${new}% (commit .coverage-floor)"
  fi
fi
